      "id": "dream-loop-synthesis",
      "label": "[[Dream Loop Synthesis]]",
      "rawTitle": "Dream Loop Synthesis",
      "filePath": "concepts/dream-loop-synthesis.md",
      "dir": "Wiki / concepts",
      "summary": "The Dream Loop is an autonomous background traversal engine that inspects knowledge graphs, uncovers hidden connections, and reconciles contradictory notes across sessions.",
