{
  "hooks": {
    "SessionStart": [
      {
        "matcher": null,
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/entire-codex.mjs session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": null,
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/entire-codex.mjs user-prompt-submit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-git.mjs", "timeout": 10 },
          { "type": "command", "command": "node scripts/hooks/guard-graphify.mjs", "timeout": 10 },
          { "type": "command", "command": "node scripts/hooks/guard-production.mjs", "timeout": 10 },
          { "type": "command", "command": "node scripts/hooks/guard-circuit.mjs", "timeout": 10 }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-production.mjs", "timeout": 10 },
          { "type": "command", "command": "node scripts/hooks/guard-circuit.mjs", "timeout": 10 }
        ]
      },
      {
        "matcher": "Agent|spawn_agent|send_message",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-communication.mjs", "timeout": 10 },
          { "type": "command", "command": "node scripts/hooks/guard-circuit.mjs", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": null,
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/entire-codex.mjs post-tool-use", "timeout": 30 },
          { "type": "command", "command": "node scripts/hooks/telemetry-post-tool.mjs", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": null,
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/entire-codex.mjs stop",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
