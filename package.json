{
  "name": "skys-the-limit-painting-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --port=3000 --hostname=0.0.0.0",
    "build": "next build",
    "build:vercel": "npm run validate:convex-deploy-env && npx convex deploy --cmd \"npm run build\" && npm run verify:convex-production-webhook",
    "validate:convex-deploy-env": "node scripts/validate-convex-deploy-env.mjs",
    "verify:convex-production-webhook": "node scripts/verify-convex-production-webhook.mjs",
    "validate:convex-preview-defaults": "node scripts/validate-convex-preview-defaults.mjs",
    "validate:convex-preview-webhook": "node scripts/validate-convex-preview-webhook.mjs",
    "provision:convex-preview-webhook": "node scripts/provision-convex-preview-webhook.mjs",
    "migration:convex": "node scripts/migrations/execute-convex.mjs",
    "postbuild": "node scripts/generate-sitemap.js",
    "preview": "next start",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => { rmSync('dist', { recursive: true, force: true }); rmSync('.next', { recursive: true, force: true }); })\"",
    "prepare": "git config core.hooksPath .husky 2>/dev/null || true",
    "lint": "npm run lint:design && npm run lint:design:changed && npm run lint:slop && node scripts/verify-architecture-decisions.mjs && node scripts/enforce-git.js && node scripts/verify-react-versions.mjs && tsc --noEmit",
    "lint:ci": "npm run lint:design && npm run lint:design:changed && npm run lint:slop && node scripts/verify-architecture-decisions.mjs && node scripts/verify-react-versions.mjs && tsc --noEmit",
    "lint:react": "node scripts/verify-react-versions.mjs",
    "lint:types": "tsc --noEmit",
    "lint:md": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\" --ignore \"wiki/**\" --ignore \".agents/wiki/**\" --ignore \"graphify-out/**\" --ignore \"**/.agents/wiki/**\"",
    "compile": "node scripts/compile.js",
    "ci": "node scripts/ci_check.js",
    "ci:contract": "node scripts/ci-contract.mjs",
    "lifecycle:verify": "node scripts/verify-development-lifecycle.mjs",
    "lifecycle:evidence": "node scripts/execution/write_evidence_receipt.mjs",
    "ledgers:query": "node scripts/execution/control-plane-ledgers.mjs query --program stl-post-g20-sequential-tdd-v1",
    "providers:preflight": "node scripts/provider-access-preflight.mjs",
    "providers:verify": "node scripts/verify-provider-access-ledger.mjs",
    "telemetry:gate": "node scripts/node-telemetry-gate.mjs",
    "arch:decisions": "node scripts/verify-architecture-decisions.mjs",
    "goal": "node scripts/goal.mjs",
    "goal:verify": "node scripts/goal.mjs verify",
    "context7:verify": "node scripts/validate-context7-contract.mjs",
    "ship:eval": "node scripts/ship-eval.mjs",
    "ship:improve": "node scripts/ship-improve.mjs",
    "graph:status": "node scripts/graph-context.mjs status",
    "graph:query": "node scripts/graph-context.mjs query",
    "graph:path": "node scripts/graph-context.mjs path",
    "graph:explain": "node scripts/graph-context.mjs explain",
    "graph:update": "node scripts/graph-context.mjs update",
    "graph:wiki": "node scripts/graph-context.mjs wiki",
    "host:compile": "node scripts/compile-host-native.mjs",
    "skills:validate": "node scripts/validate-skill-routing.mjs",
    "test": "node --import tsx --test tests/*.mjs",
    "smoke:site": "node scripts/smoke-site.mjs",
    "learn:prevent:test": "node scripts/active-prevention.mjs self-test",
    "learn:prevent:rebuild": "node scripts/active-prevention.mjs rebuild",
    "ops:harness": "node scripts/harness-ops.js",
    "ops:cron": "node scripts/cron-ops.js",
    "ops:cron:watch": "node scripts/cron-ops.js --watch",
    "ops:mock": "node scripts/harness-ops.js mock-test",
    "memory:query": "node scripts/memory-harness.js query",
    "memory:stats": "node scripts/memory-harness.js stats",
    "memory:node": "node scripts/memory-harness.js node",
    "arch:sweep": "node scripts/harness-custodian.js",
    "arch:watch": "node scripts/cron-custodian.js --watch",
    "arch:force": "node scripts/cron-custodian.js --force",
    "remotion:studio": "remotion studio remotion/index.ts",
    "render:hero": "remotion render remotion/index.ts HeroCinematic public/videos/sky-hero-cinematic.mp4 --codec=h264 --crf=20 --muted",
    "render:markets": "remotion render remotion/index.ts ResidentialLoop public/videos/sky-residential-loop.mp4 --codec=h264 --crf=22 --muted && remotion render remotion/index.ts CommercialLoop public/videos/sky-commercial-loop.mp4 --codec=h264 --crf=22 --muted && remotion render remotion/index.ts PublicSectorLoop public/videos/sky-public-sector-loop.mp4 --codec=h264 --crf=22 --muted",
    "lint:design": "node scripts/lint-design.mjs --spec",
    "lint:design:changed": "node scripts/lint-design.mjs --changed",
    "lint:design:all": "node scripts/lint-design.mjs --all",
    "lint:slop": "node scripts/lint-ui-slop.mjs --changed",
    "lint:slop:all": "node scripts/lint-ui-slop.mjs --all",
    "verify:ui-design-evidence": "node scripts/verify-ui-design-evidence.mjs",
    "design:gate": "npm run lint:design && npm run lint:design:changed && npm run lint:slop && npm run verify:ui-design-evidence"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@clerk/backend": "^3.13.1",
    "@clerk/nextjs": "^7.6.1",
    "@directus/sdk": "^23.0.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-s3": "3.88.0",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.110.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "dotenv": "17.4.2",
    "hono": "^4.13.2",
    "leaflet": "1.9.4",
    "lucide-react": "^1.24.0",
    "motion": "12.42.2",
    "next": "16.3.0",
    "payload": "3.88.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-wrap-balancer": "^1.1.1",
    "resend": "6.17.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "0.17.4",
    "@remotion/cli": "4.0.489",
    "@tailwindcss/postcss": "4.3.2",
    "@types/leaflet": "1.9.21",
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "better-sqlite3": "^12.11.1",
    "ajv": ">=8.18.0",
    "ajv-formats": "3.0.1",
    "autoprefixer": "10.5.2",
    "gray-matter": "^4.0.3",
    "jsdom": "29.1.1",
    "markdownlint-cli": "^0.49.0",
    "pg": "8.22.0",
    "postcss": "8.5.26",
    "remotion": "4.0.489",
    "tailwindcss": "4.3.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vercel": "^55.0.0"
  },
  "overrides": {
    "source-map": "0.7.6",
    "js-yaml": ">=4.1.2",
    "tar": ">=7.5.16",
    "postcss": "8.5.26",
    "undici": ">=7.29.0",
    "ws": ">=8.21.0",
    "minimatch": ">=10.2.3",
    "ajv": ">=8.18.0",
    "smol-toml": ">=1.6.1",
    "srvx": ">=0.11.13",
    "sharp": "0.35.3",
    "@tootallnate/once": ">=2.0.1",
    "esbuild": ">=0.28.1",
    "path-to-regexp": "8.4.2",
    "path-to-regexp-updated": "npm:path-to-regexp@8.4.2",
    "brace-expansion": ">=5.0.9",
    "fast-uri": ">=3.1.5",
    "hono": "$hono",
    "ip-address": ">=10.5.0",
    "nanoid": ">=3.3.17"
  }
}
