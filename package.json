{
  "name": "skys-the-limit-painting-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "24.x",
    "npm": ">=10.9.8"
  },
  "scripts": {
    "dev": "next dev --port=3000 --hostname=0.0.0.0",
    "build": "next build",
    "postbuild": "node scripts/generate-sitemap.js",
    "preview": "next start",
    "clean": "node -e \"import('node:fs').then(({ rmSync }) => { rmSync('dist', { recursive: true, force: true }); rmSync('.next', { recursive: true, force: true }); })\"",
    "prepare": "git config core.hooksPath .husky 2>/dev/null || true",
    "lint": "node scripts/enforce-git.js && node scripts/verify-react-versions.mjs && tsc --noEmit",
    "lint:ci": "npm run lint:react && npm run lint:types",
    "lint:react": "node scripts/verify-react-versions.mjs",
    "lint:types": "tsc --noEmit",
    "lint:md": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\" --ignore \"wiki/**\" --ignore \"graphify-out/**\"",
    "ci": "node scripts/ci_check.js",
    "ci:contract": "node scripts/ci-contract.mjs",
    "test": "tsx --test tests/*.mjs",
    "smoke:site": "node scripts/smoke-site.mjs",
    "remotion:studio": "remotion studio remotion/index.ts",
    "render:hero": "remotion render remotion/index.ts HeroCinematic public/videos/sky-hero-cinematic.mp4 --codec=h264 --crf=20 --muted",
    "render:markets": "remotion render remotion/index.ts ResidentialLoop public/videos/sky-residential-loop.mp4 --codec=h264 --crf=22 --muted && remotion render remotion/index.ts CommercialLoop public/videos/sky-commercial-loop.mp4 --codec=h264 --crf=22 --muted && remotion render remotion/index.ts PublicSectorLoop public/videos/sky-public-sector-loop.mp4 --codec=h264 --crf=22 --muted",
    "knip": "knip",
    "audit:fix": "npm audit fix",
    "typecheck:watch": "tsc --noEmit --watch",
    "build:analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@payloadcms/db-postgres": "3.90.1",
    "@payloadcms/next": "3.90.1",
    "@payloadcms/richtext-lexical": "3.90.1",
    "@payloadcms/storage-s3": "3.90.1",
    "@phosphor-icons/react": "2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.1",
    "express": "5.2.1",
    "leaflet": "1.9.4",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "next": "16.3.5",
    "payload": "3.90.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-wrap-balancer": "^1.1.1",
    "resend": "^6.28.1",
    "shadcn": "^4.21.0",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.526",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.6.1",
    "gray-matter": "^4.0.3",
    "jsdom": "30.1.0",
    "knip": "^6.37.0",
    "markdownlint-cli": "^0.49.1",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "remotion": "^4.0.526",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vercel": "^59.23.2"
  },
  "overrides": {
    "source-map": "0.7.6",
    "js-yaml": ">=4.1.2",
    "tar": ">=7.5.16",
    "undici": ">=7.16.0",
    "ws": ">=8.21.0",
    "minimatch": ">=10.2.3",
    "ajv": ">=8.18.0",
    "smol-toml": ">=1.7.1",
    "fast-uri": ">=3.1.7",
    "srvx": ">=0.11.13",
    "@tootallnate/once": ">=2.0.1",
    "esbuild": ">=0.25.12",
    "qs": ">=6.16.0",
    "hono": ">=4.13.5",
    "path-to-regexp": "8.4.2",
    "path-to-regexp-updated": "npm:path-to-regexp@8.4.2",
    "express": {
      "path-to-regexp": "0.1.13"
    }
  }
}
