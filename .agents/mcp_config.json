{
  "mcpServers": {
    "devhealer": {
      "command": "python",
      "args": [
        ".agents/plugins/dev-healer/mcp/server.py"
      ]
    },
    "graphify": {
      "command": "uvx",
      "args": [
        "--refresh",
        "--from",
        "graphifyy",
        "graphify-mcp",
        "--graph",
        "graphify-out/graph.json"
      ]
    }
  }
}
