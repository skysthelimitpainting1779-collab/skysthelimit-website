{
  "git-discipline": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-git.mjs", "timeout": 10 }
        ]
      }
    ]
  },
  "graphify-enforcer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "grep_search|find_by_name",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-graphify.mjs", "timeout": 10 }
        ]
      }
    ]
  },
  "circuit-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-circuit.mjs", "timeout": 10 }
        ]
      }
    ]
  },
  "production-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-production.mjs", "timeout": 10 }
        ]
      }
    ]
  },
  "communication-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "invoke_subagent|define_subagent|send_message",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/guard-communication.mjs", "timeout": 10 }
        ]
      }
    ]
  },
  "tool-telemetry": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node scripts/hooks/telemetry-post-tool.mjs", "timeout": 10 }
        ]
      }
    ]
  }
}
