{
  "stl-engineering-guards": {
    "enabled": true,
    "PreInvocation": [
      {
        "type": "command",
        "command": "node .agents/hooks/pre-invocation.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/pre-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/post-tool-use.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/hooks/stop.mjs",
        "timeout": 10
      }
    ]
  }
}