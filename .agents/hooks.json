{
  "git-discipline": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-git.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "graphify-enforcer": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "grep_search",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-graphify.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "circuit-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-circuit.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "production-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-production.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/hooks/guard-production.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
