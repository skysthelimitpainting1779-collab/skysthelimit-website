#!/bin/sh
_entire_stdin="$(mktemp "${TMPDIR:-/tmp}/entire-post-rewrite.XXXXXX")"
cat > "$_entire_stdin"
trap 'rm -f "$_entire_stdin"' EXIT
# Entire CLI hooks
# Post-rewrite hook: remap session linkage after amend/rebase rewrites
if command -v entire >/dev/null 2>&1; then entire hooks git post-rewrite "$1" < "$_entire_stdin" 2>/dev/null || true; else :; fi

# Chain: run pre-existing hook
_entire_hook_dir="$(dirname "$0")"
if [ -x "$_entire_hook_dir/post-rewrite.pre-entire" ]; then
    "$_entire_hook_dir/post-rewrite.pre-entire" "$@" < "$_entire_stdin"
fi

# agentgraph-graphify-db-sync-start
# Keeps C:/Users/Johnny Cage/DEV/dev/graphify.db current with Graphify output.
# Installed by dev/install-graphify-maintenance.ps1.
if [ "${AGENTGRAPH_GRAPHIFY_DB_SKIP:-0}" != "1" ]; then
  _ag_refresh="C:/Users/Johnny Cage/DEV/dev/refresh-graphify-worktree.ps1"
  _ag_workspace="C:/Users/Johnny Cage/DEV"
  _ag_repo="C:/Users/Johnny Cage/DEV/skysthelimit-collab"
  if command -v pwsh >/dev/null 2>&1; then
    (pwsh -NoProfile -ExecutionPolicy Bypass -File "$_ag_refresh" -Root "$_ag_repo" -WorkspaceRoot "$_ag_workspace") >/dev/null 2>&1 &
  elif command -v powershell.exe >/dev/null 2>&1; then
    (powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$_ag_refresh" -Root "$_ag_repo" -WorkspaceRoot "$_ag_workspace") >/dev/null 2>&1 &
  fi
fi
# agentgraph-graphify-db-sync-end

